#!/usr/bin/env bash
set -e

# Only run if sdks/r is modified in the commits being pushed
z40=0000000000000000000000000000000000000000

while read local_ref local_oid remote_ref remote_oid
do
  if [ "$local_oid" = "$z40" ]; then
    # Handle delete
    continue
  fi

  if [ "$remote_oid" = "$z40" ]; then
    # New branch, check against empty tree
    range="$local_oid"
  else
    # Update to existing branch, check commits between remote and local
    range="$remote_oid..$local_oid"
  fi

  if git diff --name-only "$range" -- | grep -q "^sdks/r/"; then
    echo "Changes detected in sdks/r/. Running tests before push..."
    if ! bash scripts/test-all.sh; then
      echo "Tests failed. Push aborted."
      exit 1
    fi
  fi
done

exit 0
