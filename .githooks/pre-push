#!/usr/bin/env bash
set -e

# Only run if sdks/r is modified in the commits being pushed
z40=0000000000000000000000000000000000000000
empty_tree=$(git hash-object -t tree /dev/null)

while read local_ref local_oid remote_ref remote_oid
do
  if [ "$local_oid" = "$z40" ]; then
    # Handle delete
    continue
  fi

  # Commit first, then merge origin in before the push, never rebase: a rebase rewrites commits,
  # and that is where changes get lost. remote_oid is the tip the remote advertised; not an
  # ancestor (or not even fetched) means origin has commits you lack.
  case "$remote_ref" in refs/heads/*)
    if [ "$remote_oid" != "$z40" ] && ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
      b="${remote_ref#refs/heads/}"
      n="$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
      echo "REFUSED: origin/$b has commits you do not have. In this order -- merge, never rebase:" >&2
      if [ "$n" != 0 ]; then
        echo "       1. COMMIT FIRST: $n uncommitted change(s) here -> git add <paths> && git commit" >&2
      else
        echo "       1. commit first: nothing uncommitted here" >&2
      fi
      # The merge must land on the branch being pushed, not on whatever is checked out.
      cur="$(git symbolic-ref --short -q HEAD || echo 'a detached HEAD')"
      s=2
      if [ "$cur" != "$b" ]; then
        echo "       2. git switch $b   (you are on '$cur'; the merge must land on $b)" >&2
        s=3
      fi
      echo "       $s. git pull --no-rebase origin $b   (merge; your commits keep their exact SHAs)" >&2
      echo "          CONFLICT? edit each listed file (keep the right lines from both sides, delete the" >&2
      echo "          <<<<<<< ======= >>>>>>> markers), git add <files>, git commit, run the affected tests." >&2
      echo "          Stuck? git merge --abort puts you back exactly on your commit." >&2
      echo "       $((s + 1)). git push origin $b" >&2
      echo "       Never rebase or force-push: a rebase rewrites commits and loses changes." >&2
      exit 1
    fi
    # Never PUBLISH an unresolved merge conflict (a file `git add`ed with its markers still in
    # commits silently). The commit stays allowed; the push is refused while the pushed range ADDS
    # a marker line (net, so a later fix commit clears it).
    if [ "$remote_oid" != "$z40" ]; then
      marker_re='^(<<<<<<<|>>>>>>>|[|]{7})( |$)'
      markers="$(git diff -U0 "$remote_oid" "$local_oid" 2>/dev/null | grep -cE "^[+]${marker_re#^}" || true)"
      if [ "${markers:-0}" != 0 ]; then
        echo "REFUSED: this push adds $markers unresolved merge-conflict marker line(s):" >&2
        # shellcheck disable=SC2046 # word-split file list, display only
        git grep -nE "$marker_re" "$local_oid" -- $(git diff --name-only --diff-filter=AM "$remote_oid" "$local_oid") 2>/dev/null \
          | sed "s/^$local_oid://" | head -10 | sed 's/^/       /' >&2 || true
        echo "       Resolve each one (keep the right lines from both sides, delete the markers), then:" >&2
        echo "       git add <files> && git commit -m 'resolve merge conflicts' && git push origin ${remote_ref#refs/heads/}" >&2
        exit 1
      fi
    fi
    ;;
  esac

  if [ "$remote_oid" = "$z40" ]; then
    # New branch, check against empty tree
    range="$empty_tree..$local_oid"
  else
    # Update to existing branch, check commits between remote and local
    range="$remote_oid..$local_oid"
  fi

  if git diff --name-only "$range" -- | grep -q "^sdks/r/"; then
    echo "Changes detected in sdks/r/. Running tests before push..."
    if ! bash scripts/test-all.sh < /dev/null; then
      echo "Tests failed. Push aborted."
      exit 1
    fi
  fi
done

exit 0
