# nRouter image-agent example — copy to .env and fill in the key.
#
#   cp .env.example .env && node --env-file=.env image-agent.mjs
#
# Nothing here is a secret in this file; NEVER commit the .env you make from it.

# REQUIRED. Your nRouter virtual key. This is the only credential the example
# needs: nRouter holds the provider keys, so there is no OpenAI key to supply.
NROUTER_API_KEY=sk-nrouter-your-key-here

# The gateway. Leave unset for production.
# NROUTER_BASE_URL=https://api.nrouter.ai/v1

# The model, and with it the BILLING UNIT. A `gpt-image-*` id is priced per
# image TOKEN and returns a `usage` block; anything else is priced per IMAGE,
# as a function of count, size and quality, and returns no usage at all.
# NROUTER_IMAGE_MODEL=gpt-image-1-mini

# Size and quality. Both are PRICE INPUTS for a per-image model, and neither
# comes back in a response header — this example records what it asked for so
# the spend row can be reconciled against something.
# NROUTER_IMAGE_SIZE=1024x1024
# NROUTER_IMAGE_QUALITY=low

# Images per call. The gateway caps this at 10 and holds max($0.35, $0.35 x n)
# before calling the provider, so raising it raises the hold linearly.
# NROUTER_IMAGE_N=1

# How many prompts to run. Each one is a separate billed call.
# NROUTER_IMAGE_PROMPTS=2

# `b64_json` returns the bytes inside the JSON body; `url` returns a link this
# example RECORDS but deliberately does not download. Left unset the example
# decides: `gpt-image-*` models always return b64 and REJECT this parameter, so
# it is omitted for them and set to b64_json for everything else.
# NROUTER_IMAGE_RESPONSE_FORMAT=b64_json

# Where the images and the per-call spend log go. Both default inside this
# directory and both are gitignored.
# NROUTER_IMAGE_OUT=./out
# NROUTER_IMAGE_LOG=./image-agent.log.jsonl
