# This repository is PUBLIC and the README says `cp .env.example .env`, so a
# missing rule here turns the next `git add` into a disclosed API key.
.env

# Generated video and the per-call spend log. Both are session output, not
# source: the video is billed content (a few seconds of it is megabytes) and
# the log carries request ids and the sealed job handle, neither of which
# belongs in a public repository.
out/
*.log.jsonl
