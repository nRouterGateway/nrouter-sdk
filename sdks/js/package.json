{
  "name": "@nrouter_ai/sdk",
  "version": "3.1.1",
  "description": "nRouter SDK — one API key for models across six provider clouds. Native OpenAI and Anthropic wire formats, plus embeddings, audio, images and video.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/README.md",
    "docs/audio.md",
    "docs/cost.md",
    "docs/errors.md",
    "docs/guardrails.md",
    "docs/images.md",
    "docs/memory.md",
    "docs/prompts.md",
    "docs/routing.md",
    "docs/video.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('node:fs').copyFileSync('src/index.mjs','dist/index.mjs')\"",
    "test": "npm run build && node test/smoke.js && node test/package-entry.cjs && node test/package-entry.mjs && node test/package-entry-parity.mjs"
  },
  "keywords": [
    "llm",
    "ai",
    "nrouter",
    "gateway",
    "llm-gateway",
    "openai",
    "anthropic",
    "claude",
    "bedrock",
    "vertex-ai",
    "azure",
    "qwen",
    "api"
  ],
  "author": "nRouter <hello@nrouter.ai>",
  "homepage": "https://nrouter.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nRouterGateway/nrouter-sdk.git",
    "directory": "sdks/js"
  },
  "bugs": {
    "url": "https://github.com/nRouterGateway/nrouter-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
