# Copy to .env and fill in. NEVER commit a real key - this repo is PUBLIC.
NROUTER_API_KEY=sk-nrouter-...
# Default is https://api.nrouter.ai/v1. Point at a local gateway for development.
NROUTER_BASE_URL=http://localhost:4000/v1
NROUTER_MODEL=claude-fable-5

# --- optional; both have defaults, so leave them commented for the stock demo ---
# The prompt to send. Default asks why an unknown price is "unpriced", not zero.
#NROUTER_PROMPT=In two sentences, why should an LLM gateway report an unknown price as "unpriced" rather than as zero?
# Output ceiling for the one request. Default 200. This is what you pay for, so
# raise it deliberately: a bigger number is a bigger bill, not a better answer.
#NROUTER_MAX_TOKENS=200
