# nRouter voice-agent example — copy to .env and fill in the key.
#
#   cp .env.example .env && node --env-file=.env voice-agent.mjs
#
# Nothing here is a secret in this file; NEVER commit the .env you make from it.

# REQUIRED. Your nRouter virtual key. This is the only credential the example
# needs: nRouter holds the provider keys, so there is no OpenAI or Anthropic
# key to supply.
NROUTER_API_KEY=sk-nrouter-your-key-here

# The gateway. Leave unset for production.
# NROUTER_BASE_URL=https://api.nrouter.ai/v1

# The three models, one per billed wire.
# A Claude-family id takes the /v1/messages wire, which the SDK selects for you.
# nrouter-doc-wire: messages
# NROUTER_CHAT_MODEL=claude-haiku-4-5-20251001
# NROUTER_SPEECH_MODEL=tts-1
# NROUTER_SPEECH_VOICE=alloy
# NROUTER_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Audio container for the synthesised speech: mp3, opus, aac, flac, wav or pcm.
# Unset takes the provider default (mp3). The SDK checks this against its own
# list BEFORE sending, so a typo is refused locally and costs nothing — the
# example reports that as its own failure class, distinct from a refusal that
# came back FROM the gateway.
# NROUTER_SPEECH_FORMAT=mp3

# Transcription response format. Left unset the example picks it: `whisper-1`
# is billed per SECOND of audio and the gateway can only learn the duration
# from a verbose_json body, so a whisper model gets verbose_json and anything
# else gets the provider default. Override only if you know why.
# NROUTER_TRANSCRIBE_FORMAT=verbose_json

# How many caller/agent exchanges to run. Each turn is three billed calls
# (transcribe, chat, speak) plus one more to synthesise the next caller line.
# NROUTER_TURNS=2

# Cap the assistant's reply length. Speech is billed per CHARACTER, so this is
# a cost control on TWO wires, not one.
# NROUTER_MAX_TOKENS=120

# A real recording to start from (wav/mp3/m4a/...). Leave unset and the example
# synthesises the caller's opening line with TTS first, so it runs with no
# microphone and no fixture file.
# NROUTER_AUDIO_IN=./caller.wav

# Where the per-call JSONL log and the generated audio go. Both default inside
# this directory and both are gitignored.
# NROUTER_VOICE_LOG=./voice-agent.log.jsonl
# NROUTER_VOICE_OUT=./out

# Override the scripted conversation.
# NROUTER_SYSTEM_PROMPT=You are a concise voice assistant.
# NROUTER_OPENING_LINE=Hi, has my order shipped yet?
