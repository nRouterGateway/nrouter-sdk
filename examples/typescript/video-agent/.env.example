# nRouter video-agent example — copy to .env and fill in the key.
#
#   cp .env.example .env && node --env-file=.env video-agent.mjs
#
# Nothing here is a secret in this file; NEVER commit the .env you make from it.

# REQUIRED. Your nRouter virtual key. This is the only credential the example
# needs: nRouter holds the provider keys, so there is no OpenAI key to supply.
NROUTER_API_KEY=sk-nrouter-your-key-here

# The gateway. Leave unset for production.
# NROUTER_BASE_URL=https://api.nrouter.ai/v1

# The model. Video is served on `POST /v1/videos` only; there is no wire choice
# to make here the way there is for chat.
# NROUTER_VIDEO_MODEL=sora-2

# ⚠ THE TWO COST DIALS. The credit reservation is `max($3.00, $0.75 x seconds)`,
# taken BEFORE the provider is called, and the settlement is computed from the
# seconds the accepted job reports. Doubling `seconds` roughly doubles the bill.
# Resolution selects the per-second RATE, so a larger `size` is a second
# multiplier on the same number of seconds.
# NROUTER_VIDEO_SECONDS=4
# NROUTER_VIDEO_SIZE=1280x720

# What to render.
# NROUTER_VIDEO_PROMPT=A slow overhead shot of rain falling into a still puddle.

# Polling. The two GETs are FREE, so a shorter interval costs nothing in money —
# but every poll still takes an RPM slot, so a tight loop buys a 429 rather than
# a faster answer. A render takes minutes; the default timeout is ten of them.
# NROUTER_VIDEO_POLL_MS=5000
# NROUTER_VIDEO_TIMEOUT_MS=600000

# Where the per-call JSONL log and the rendered video go. Both default inside
# this directory and both are gitignored.
# NROUTER_VIDEO_LOG=./video-agent.log.jsonl
# NROUTER_VIDEO_OUT=./out
