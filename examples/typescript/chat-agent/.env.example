# nRouter chat-agent example — copy to .env and fill in the key.
#
#   cp .env.example .env && node --env-file=.env chat-agent.mjs
#
# Nothing here is a secret in this file; NEVER commit the .env you make from it.

# REQUIRED. Your nRouter virtual key. This is the only credential the example
# needs: nRouter holds the provider keys, so there is no OpenAI or Anthropic
# key to supply.
NROUTER_API_KEY=sk-nrouter-your-key-here

# The gateway. Leave unset for production.
# NROUTER_BASE_URL=https://api.nrouter.ai/v1

# THREE models, one per text wire, because the SDK picks the wire from the id.
# An Anthropic-family id takes /v1/messages and is served on that wire ONLY.
# nrouter-doc-wire: messages
# NROUTER_MESSAGES_MODEL=claude-haiku-4-5-20251001
# NROUTER_CHAT_MODEL=gpt-4.1-mini
# NROUTER_RESPONSES_MODEL=gpt-4.1-mini

# How many exchanges to run. Each turn is five billed calls (messages, chat,
# responses, streamed chat, the repeated chat body) plus one free count_tokens.
# NROUTER_TURNS=2

# Cap the reply length on every wire.
# NROUTER_MAX_TOKENS=120

# Where the per-call JSONL log goes. Defaults inside this directory, and is
# gitignored.
# NROUTER_CHAT_LOG=./chat-agent.log.jsonl

# Override the scripted conversation.
# NROUTER_SYSTEM_PROMPT=You are a concise support assistant.
# NROUTER_OPENING_LINE=Hi, has my order shipped yet?

# OPTIONAL. Your own rates, in USD per MILLION tokens, used to RECOMPUTE what
# the streamed calls probably cost from the token counts their frames carried.
# Both must be set or nothing is recomputed. NO RATE CARD SHIPS WITH THIS
# EXAMPLE ON PURPOSE: a price table baked into a public repository rots silently
# and is then read as authoritative. Whatever this produces is an ESTIMATE,
# printed on its own line and never added to the settled total — the gateway
# settles the same frames itself and the spend row is the invoice.
# NROUTER_STREAM_RATE_IN_PER_MTOK=0.40
# NROUTER_STREAM_RATE_OUT_PER_MTOK=1.60
