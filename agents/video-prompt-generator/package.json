{
  "name": "@nrouter_ai/video-prompt-generator",
  "version": "0.1.0",
  "description": "Generate production-ready prompts for AI video tools (Google Veo, Luma Dream Machine, Runway Gen-3, OpenAI Sora) through nRouter.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nrouter_ai/sdk": "3.1.2"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "keywords": [
    "nrouter",
    "video-generator",
    "prompt-generator",
    "ai-agent"
  ],
  "author": "nRouter <hello@nrouter.ai>",
  "homepage": "https://nrouter.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nRouterGateway/nrouter-sdk.git",
    "directory": "agents/video-prompt-generator"
  },
  "bugs": {
    "url": "https://github.com/nRouterGateway/nrouter-sdk/issues"
  }
}
