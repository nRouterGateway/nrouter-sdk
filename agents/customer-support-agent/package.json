{
  "name": "@nrouter_ai/support-agent",
  "version": "0.1.0",
  "description": "A streaming customer-support agent built on @nrouter_ai/sdk: retrieval over your own docs, tools, confidence and citations. One API key, no database.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "support-agent": "./bin/support-agent.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@nrouter_ai/sdk": "3.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "keywords": [
    "nrouter",
    "support-agent",
    "customer-support",
    "rag",
    "llm",
    "ai-agent"
  ],
  "author": "nRouter <hello@nrouter.ai>",
  "homepage": "https://nrouter.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nRouterGateway/nrouter-sdk.git",
    "directory": "agents/customer-support-agent"
  },
  "bugs": {
    "url": "https://github.com/nRouterGateway/nrouter-sdk/issues"
  }
}
